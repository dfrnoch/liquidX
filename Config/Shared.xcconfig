// Shared.xcconfig: project-level settings for every configuration.
// Personal overrides (signing team, X Client ID) go in Config/Local.xcconfig,
// which is git-ignored. Copy Config/Local.xcconfig.example to start.

SDKROOT = auto
SUPPORTED_PLATFORMS = iphoneos iphonesimulator macosx
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO
TARGETED_DEVICE_FAMILY = 1,2
IPHONEOS_DEPLOYMENT_TARGET = 26.0
MACOSX_DEPLOYMENT_TARGET = 26.0

// The next release (MAJOR.MINOR.PATCH). CI overrides CURRENT_PROJECT_VERSION.
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// Swift 6 language mode with the same upcoming features as LiquidKit.
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_UPCOMING_FEATURE_EXISTENTIAL_ANY = YES
SWIFT_UPCOMING_FEATURE_INTERNAL_IMPORTS_BY_DEFAULT = YES
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES

// Unsigned-friendly defaults: macOS and the simulator sign ad hoc ("Sign to
// Run Locally"). Set DEVELOPMENT_TEAM in Local.xcconfig to run on a device.
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
CODE_SIGN_IDENTITY[sdk=iphoneos*] = Apple Development
DEVELOPMENT_TEAM =

ENABLE_PREVIEWS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
ALWAYS_SEARCH_USER_PATHS = NO
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
ENABLE_STRICT_OBJC_MSGSEND = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
DEAD_CODE_STRIPPING = YES
COPY_PHASE_STRIP = NO

// Empty by default: users can paste a Client ID in the app instead.
LIQUIDX_X_CLIENT_ID =

#include? "Local.xcconfig"
